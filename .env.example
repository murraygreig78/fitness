# Copy to .env and fill in. Never commit the real key.
# WorkoutX: https://api.workoutxapp.com  header X-WorkoutX-Key
WORKOUTX_API_KEY=

# Plausible analytics (optional). Leave blank to disable.
# Domain only, e.g. murraygreig78.github.io
PUBLIC_PLAUSIBLE_DOMAIN=
# Optional script URL override (default https://plausible.io/js/script.js)
PUBLIC_PLAUSIBLE_SRC=
