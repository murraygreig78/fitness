# Copy to .env and fill in. Never commit the real key.
# WorkoutX: https://api.workoutxapp.com  header X-WorkoutX-Key
WORKOUTX_API_KEY=

# GoatCounter analytics (optional). Leave blank to disable.
# Full count endpoint from your GoatCounter site settings, e.g.
# https://yourcode.goatcounter.com/count
PUBLIC_GOATCOUNTER_ENDPOINT=
# Optional script URL override (default https://gc.zgo.at/count.js)
PUBLIC_GOATCOUNTER_SRC=
